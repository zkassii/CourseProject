@{
    var path = Context.Request.Path.Value ?? "/";
    bool Active(string p) => path.StartsWith(p, StringComparison.OrdinalIgnoreCase);

    // "Иванова Анна" -> "Иванова А."
    string ShortName(string? full)
    {
        if (string.IsNullOrWhiteSpace(full)) return "";
        var parts = full.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1 ? parts[0] + " " + char.ToUpper(parts[1][0]) + "." : parts[0];
    }

    // сотруднику и администратору "Каталог" в меню не нужен
    bool showCatalog = !(User.IsInRole(RoleNames.Staff) || User.IsInRole(RoleNames.Admin));
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Хвостики</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ShelterApp.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="site-header">
        <nav class="navbar navbar-expand-md navbar-dark">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="4" r="2" /><circle cx="18" cy="8" r="2" /><circle cx="20" cy="16" r="2" />
                        <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z" />
                    </svg>
                    <span>Хвостики</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-md-center">

                        @if (showCatalog)
                        {
                            <li class="nav-item"><a class="nav-link @(Active("/Animals") ? "active" : "")" href="/Animals">Каталог</a></li>
                        }
                        @if (User.IsInRole(RoleNames.User))
                        {
                            <li class="nav-item"><a class="nav-link @(Active("/MyRequests") ? "active" : "")" href="/MyRequests">Мои заявки</a></li>
                        }
                        @if (User.IsInRole(RoleNames.Staff))
                        {
                            <li class="nav-item"><a class="nav-link @(Active("/Staff/Animals") ? "active" : "")" href="/Staff/Animals">Животные</a></li>
                            <li class="nav-item"><a class="nav-link @(Active("/Staff/Requests") ? "active" : "")" href="/Staff/Requests">Заявки</a></li>
                            <li class="nav-item"><a class="nav-link @(Active("/Staff/Enclosures") ? "active" : "")" href="/Staff/Enclosures">Вольеры</a></li>
                        }
                        @if (User.IsInRole(RoleNames.Vet))
                        {
                            <li class="nav-item"><a class="nav-link @(Active("/Vet") ? "active" : "")" href="/Vet/Records">Ветеринарные записи</a></li>
                        }
                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <li class="nav-item"><a class="nav-link @(Active("/Admin/Users") ? "active" : "")" href="/Admin/Users">Пользователи</a></li>
                            <li class="nav-item"><a class="nav-link @(Active("/Admin/Reports") ? "active" : "")" href="/Admin/Reports">Отчеты</a></li>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><span class="nav-link">@ShortName(User.Identity.Name)</span></li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">Выйти</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @(Active("/Account/Login") ? "active" : "")" href="/Account/Login">Войти</a></li>
                            <li class="nav-item"><a class="btn btn-secondary btn-sm ms-md-2" href="/Account/Register">Регистрация</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1 py-4">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">© 2026 Приют для бездомных животных «Хвостики»</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>