@page
@model ShelterApp.Pages.Admin.ReportsModel
@using ShelterApp.Services
@{ ViewData["Title"] = "Отчеты"; }

<h1 class="mb-4">Отчеты</h1>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label class="form-label" for="ReportType">Вид отчета</label>
                    <select id="ReportType" name="ReportType" class="form-select">
                        @foreach (var t in ReportBuilder.Types)
                        {
                            <option value="@t.Value" selected="@(Model.ReportType == t.Value)">@t.Text</option>
                        }
                    </select>
                    <span asp-validation-for="ReportType" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-1">
                    <div class="col-6">
                        <label asp-for="From" class="form-label">Период: с</label>
                        <input asp-for="From" class="form-control" />
                        <span asp-validation-for="From" class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="To" class="form-label">по</label>
                        <input asp-for="To" class="form-control" />
                        <span asp-validation-for="To" class="text-danger"></span>
                    </div>
                </div>
                <p class="text-muted small">Для отчета «Текущее количество животных» период не нужен.</p>

                <button type="submit" class="btn btn-primary">Сформировать (.xlsx)</button>
            </form>
        </div>
    </div>
</div>