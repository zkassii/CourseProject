@page
@model ShelterApp.Pages.Animals.IndexModel
@{ ViewData["Title"] = "Каталог животных"; }

<form method="get" class="mb-4">
    <div class="d-flex gap-2 mb-2">
        <input type="text" name="Search" value="@Model.Search" class="form-control"
               placeholder="Кличка, вид или порода" />
        <button type="submit" class="btn btn-primary px-4">Найти</button>
        <a href="/Animals" class="btn btn-secondary px-4">Сбросить</a>
    </div>

    <div class="filters-row">
        <select name="Species" class="form-select">
            <option value="" disabled hidden selected="@(string.IsNullOrEmpty(Model.Species))">Вид</option>
            @foreach (var s in Model.SpeciesList)
            {
                <option value="@s" selected="@(Model.Species == s)">@s</option>
            }
        </select>
        <select name="Breed" class="form-select">
            <option value="" disabled hidden selected="@(string.IsNullOrEmpty(Model.Breed))">Порода</option>
            @foreach (var b in Model.BreedList)
            {
                <option value="@b" selected="@(Model.Breed == b)">@b</option>
            }
        </select>
        <select name="Gender" class="form-select">
            <option value="" disabled hidden selected="@(string.IsNullOrEmpty(Model.Gender))">Пол</option>
            <option value="Самец" selected="@(Model.Gender == "Самец")">Самец</option>
            <option value="Самка" selected="@(Model.Gender == "Самка")">Самка</option>
        </select>
        <select name="Age" class="form-select">
            <option value="" disabled hidden selected="@(string.IsNullOrEmpty(Model.Age))">Возраст</option>
            <option value="lt1" selected="@(Model.Age == "lt1")">До 1 года</option>
            <option value="1to3" selected="@(Model.Age == "1to3")">От 1 до 3 лет</option>
            <option value="gt3" selected="@(Model.Age == "gt3")">Старше 3 лет</option>
        </select>
        <select name="Status" class="form-select">
            <option value="" disabled hidden selected="@(string.IsNullOrEmpty(Model.Status))">Статус</option>
            @foreach (var st in ShelterApp.Pages.Animals.IndexModel.CatalogStatuses)
            {
                <option value="@st" selected="@(Model.Status == st)">@st</option>
            }
        </select>
        <select name="Sort" class="form-select">
            <option value="" disabled hidden selected="@(string.IsNullOrEmpty(Model.Sort))">Сортировка</option>
            <option value="name_asc" selected="@(Model.Sort == "name_asc")">По алфавиту (А–Я)</option>
            <option value="name_desc" selected="@(Model.Sort == "name_desc")">По алфавиту (Я–А)</option>
            <option value="age_young" selected="@(Model.Sort == "age_young")">Сначала младшие</option>
            <option value="age_old" selected="@(Model.Sort == "age_old")">Сначала старшие</option>
            <option value="intake_new" selected="@(Model.Sort == "intake_new")">Сначала новые</option>
            <option value="intake_old" selected="@(Model.Sort == "intake_old")">Сначала давние</option>
        </select>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="card p-4 text-center">Животные не найдены. Попробуйте изменить условия поиска.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var a in Model.Items)
        {
            <div class="col">
                <a asp-page="/Animals/Details" asp-route-id="@a.AnimalId" class="animal-link">
                    <div class="card animal-card">
                        <div class="animal-photo">
                            @if (!string.IsNullOrEmpty(a.PhotoPath))
                            {
                                <img src="@a.PhotoPath" alt="@a.Name" />
                            }
                            else
                            {
                                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="4" r="2" /><circle cx="18" cy="8" r="2" /><circle cx="20" cy="16" r="2" />
                                    <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z" />
                                </svg>
                            }
                        </div>
                        <div class="card-body">
                            <div class="fw-semibold">@a.Name</div>
                            <div class="small text-muted mb-2">
                                @(string.IsNullOrEmpty(a.Breed) ? a.Species : a.Breed) • @AnimalHelper.AgeText(a.BirthDate) • @a.Gender
                            </div>
                            <span class="status-badge @AnimalHelper.StatusClass(a.Status) d-block text-center">@a.Status</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}