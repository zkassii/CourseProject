@page "{id:int}"
@model ShelterApp.Pages.Animals.DetailsModel
@{ ViewData["Title"] = Model.Item.Name; }

<p class="small"><a href="@Model.BackUrl">← Назад к списку</a></p>

@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
@if (TempData["Ok"] is string ok) { <div class="alert alert-success">@ok</div> }

<div class="row g-4">
    <!-- левая колонка: фото и кнопки сотрудника -->
    <div class="col-md-5">
        <div class="animal-photo large">
            @if (!string.IsNullOrEmpty(Model.Item.PhotoPath))
            {
                <img src="@Model.Item.PhotoPath" alt="@Model.Item.Name" />
            }
            else
            {
                <svg width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="4" r="2" /><circle cx="18" cy="8" r="2" /><circle cx="20" cy="16" r="2" />
                    <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z" />
                </svg>
            }
        </div>

        @if (Model.CanManage)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a class="btn btn-primary" asp-page="/Staff/Animals/Edit" asp-route-id="@Model.Item.AnimalId">Изменить</a>

                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Сменить статус
                    </button>
                    <ul class="dropdown-menu">
                        @foreach (var s in AnimalStatus.All)
                        {
                            <li>
                                <form method="post" asp-page-handler="Status" asp-route-id="@Model.Item.AnimalId">
                                    <input type="hidden" name="status" value="@s" />
                                    <button type="submit" class="dropdown-item @(s == Model.Item.Status ? "active" : "")">@s</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>

                <partial name="_Confirm" model='new ConfirmModel("Удалить", "Delete", Model.Item.AnimalId, "Удалить животное " + Model.Item.Name + "?", "btn btn-danger")' />
            </div>
        }
    </div>

    <!-- правая колонка: кличка, статус, вкладки -->
    <div class="col-md-7">
        <div class="d-flex align-items-center gap-3 mb-3">
            <h1 class="mb-0">@Model.Item.Name</h1>
            <span class="status-badge @AnimalHelper.StatusClass(Model.Item.Status)">@Model.Item.Status</span>
        </div>

        @if (Model.CanSeeHistory)
        {
            <ul class="nav nav-pills mb-3" role="tablist">
                <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-data" type="button">Данные</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-vet" type="button">Ветеринария</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-encl" type="button">Вольер</button></li>
            </ul>
        }

        <div class="tab-content">
            <!-- вкладка "Данные" -->
            <div class="tab-pane fade show active" id="tab-data">
                <table class="table">
                    <tbody>
                        <tr><th style="width:40%">Вид / порода</th>
                            <td>@Model.Item.Species@(string.IsNullOrEmpty(Model.Item.Breed) ? "" : " / " + Model.Item.Breed)</td></tr>
                        <tr><th>Пол, возраст</th><td>@Model.Item.Gender, @AnimalHelper.AgeText(Model.Item.BirthDate)</td></tr>
                        <tr><th>Поступил</th><td>@Model.Item.IntakeDate.ToString("dd.MM.yyyy")</td></tr>
                        @if (Model.CanSeeHistory)
                        {
                            <tr><th>Вольер</th><td>@(Model.Item.Enclosure?.Number ?? "не назначен")</td></tr>
                        }
                    </tbody>
                </table>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <p class="text-muted">Чтобы подать заявку на животное, <a href="/Account/Login">войдите</a>
                        или <a href="/Account/Register">зарегистрируйтесь</a>.</p>
                }
                else if (User.IsInRole(RoleNames.User))
                {
                    if (Model.HasActiveRequest)
                    {
                        <div class="alert alert-info">Вы уже подали заявку на это животное.
                            Следить за ней можно в разделе <a href="/MyRequests">«Мои заявки»</a>.</div>
                    }
                    else if (Model.Item.Status == AnimalStatus.Ready)
                    {
                        <partial name="_Confirm" model='new ConfirmModel("Подать заявку", "Apply", Model.Item.AnimalId, "Подать заявку на " + Model.Item.Name + "?", "btn btn-primary btn-lg")' />
                    }
                    else
                    {
                        <p class="text-muted">На это животное сейчас нельзя подать заявку.</p>
                    }
                }
            </div>

            @if (Model.CanSeeHistory)
            {
                <!-- вкладка "Ветеринария" -->
                <div class="tab-pane fade" id="tab-vet">
                    @if (User.IsInRole(RoleNames.Vet))
                    {
                        <p><a asp-page="/Vet/Records/Edit" asp-route-animalId="@Model.Item.AnimalId" class="btn btn-primary btn-sm">Добавить запись</a></p>
                    }
                    @if (Model.Item.VetRecords.Count == 0)
                    {
                        <p class="text-muted">Записей пока нет.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <thead><tr><th>Дата</th><th>Тип</th><th>Примечание</th><th>Ветеринар</th></tr></thead>
                                <tbody>
                                    @foreach (var r in Model.Item.VetRecords)
                                    {
                                        <tr>
                                            <td class="text-nowrap">@r.RecordDate.ToString("dd.MM.yyyy")</td>
                                            <td>@r.RecordType</td>
                                            <td>@r.Notes</td>
                                            <td>@r.User?.FullName</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- вкладка "Вольер" -->
                <div class="tab-pane fade" id="tab-encl">
                    @if (Model.Item.Enclosure == null)
                    {
                        <p class="text-muted">Вольер не назначен.</p>
                    }
                    else
                    {
                        var e = Model.Item.Enclosure;
                        <table class="table">
                            <tbody>
                                <tr><th style="width:40%">Номер</th><td>@e.Number</td></tr>
                                <tr><th>Вместимость</th><td>@e.Capacity</td></tr>
                                <tr><th>Занято</th><td>@Model.EnclosureAnimals.Count</td></tr>
                                <tr><th>Свободно</th><td>@(e.Capacity - Model.EnclosureAnimals.Count)</td></tr>
                                <tr><th>Животные в вольере</th>
                                    <td>
                                        @foreach (var other in Model.EnclosureAnimals)
                                        {
                                            <div><a asp-page="/Animals/Details" asp-route-id="@other.AnimalId">@other.Name</a></div>
                                        }
                                    </td></tr>
                            </tbody>
                        </table>
                    }
                </div>
            }
        </div>
    </div>
</div>