@page "{id:int}"
@model ShelterApp.Pages.Staff.Enclosures.EditModel
@{ ViewData["Title"] = "Изменение вольера"; }

<h1 class="mb-3">Изменение вольера</h1>

<div class="row">
    <div class="col-md-6 col-lg-4">
        <div class="card p-4">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.Number" class="form-label"></label>
                    <input asp-for="Input.Number" class="form-control" />
                    <span asp-validation-for="Input.Number" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Capacity" class="form-label"></label>
                    <input asp-for="Input.Capacity" class="form-control" />
                    <span asp-validation-for="Input.Capacity" class="text-danger"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a asp-page="/Staff/Enclosures/Index" class="btn btn-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}та