@page
@model ShelterApp.Pages.Staff.Requests.IndexModel
@{ ViewData["Title"] = "Заявки"; }

@if (TempData["Ok"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="stat-card"><span class="num">@Model.InShelter</span>в приюте</div></div>
    <div class="col-6 col-md-3"><div class="stat-card"><span class="num">@Model.FreePlaces</span>свободных мест</div></div>
    <div class="col-6 col-md-3"><div class="stat-card"><span class="num">@Model.NewRequests</span>новых заявок</div></div>
    <div class="col-6 col-md-3"><div class="stat-card"><span class="num">@Model.InTreatment</span>на лечении</div></div>
</div>

<form method="post">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr><th>№</th><th>Животное</th><th>Заявитель</th><th>Дата</th><th>Статус</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Items)
                        {
                            <tr>
                                <td>
                                    <label class="d-flex align-items-center gap-2 mb-0">
                                        <input type="radio" name="id" value="@r.RequestId" class="form-check-input mt-0" />
                                        @r.RequestId
                                    </label>
                                </td>
                                <td>@r.Animal?.Name</td>
                                <td>
                                    @r.User?.FullName
                                    <div class="small text-muted">@r.User?.Email@(string.IsNullOrEmpty(r.User?.Phone) ? "" : ", " + r.User!.Phone)</div>
                                </td>
                                <td class="text-nowrap">@r.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td><span class="status-badge @RequestHelper.StatusClass(r.Status)">@r.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Items.Count == 0) { <p class="text-muted">Заявок нет.</p> }
        </div>

        <div class="col-lg-4">
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" asp-page-handler="Approve" class="btn btn-primary">Принять</button>
                <button type="submit" asp-page-handler="Reject" class="btn btn-secondary">Отклонить</button>
                <button type="submit" asp-page-handler="Transfer" class="btn btn-secondary">Оформить передачу</button>
            </div>
            <p class="text-muted small mt-3">Выберите заявку кружком в таблице и нажмите нужную кнопку.</p>
        </div>
    </div>
</form>